# 서버의 /etc/randomdrive.env 틀. setup.sh가 복사한다. 실제 키는 서버에서만 채우고 git에 넣지 않는다.

# 휴대폰·앱이 접속하는 공개 주소(QR·영상·썸네일 주소에 들어감)
PUBLIC_BASE_URL=https://__DOMAIN__

# VWorld 인증키(위성 지도·출발 동네 이름). 비우면 격자 바닥·이름 없이 만든다.
VWORLD_API_KEY=

RECAP_STORAGE_DIR=/var/lib/randomdrive/recaps
FFMPEG_PATH=/usr/bin/ffmpeg
# 1GB 메모리 서버: 영상 한 편 지도 타일 상한(1장 ≈ 256KB)
RECAP_MAXTILES=600

# 트립 DB(H2 파일). 이 경로 + .mv.db 파일 하나. 백업은 이 파일(또는 Lightsail 스냅샷).
DB_PATH=/var/lib/randomdrive/db/randomdrive

# 앱 키(X-App-Key). 쉼표로 여러 개 = 교체 기간. 비우면 키 검사 안 함(앱이 헤더를 보내기 전).
API_KEYS=
